# =============================================================================
# xRuto frontend — copy to .env for local dev, .env.production for prod build
# =============================================================================
# Local dev (Vite dev server)
VITE_API_URL=http://localhost:5000/api

# ⚠️  For production builds, create .env.production (also gitignored):
# VITE_API_URL=https://your-backend.railway.app/api

# Optional: set to "true" only if you need slow legacy analytics (not recommended)
VITE_LEGACY_ANALYTICS=false
